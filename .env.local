NEXT_PUBLIC_SUPABASE_URL=https://vkewndfogaallejojbvl.supabase.co

# Publishable/anon key — safe for client-side use (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZrZXduZGZvZ2FhbGxlam9qYnZsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxOTI3NjAsImV4cCI6MjEwNTc2ODc2MH0.X04dIF5DoZO6ODpQFADfbMsVZ4VHlx3cHF1borj895Y

# Newer-style publishable key (interchangeable with the anon key above
# for most client libraries going forward).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uo6ARZRocg02UNVavEPytg_cTSBFb9S

# SERVICE ROLE KEY — required by app/api/v1/spatial/verify/route.ts
# (it bypasses RLS to write audit_logs and read across parcels/
# encumbrances). NOT retrievable via this connector for security reasons.
# Get it from: Supabase Dashboard -> plotas project -> Project Settings
# -> API -> service_role secret. Never commit this value or expose it
# to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=__PASTE_YOUR_SERVICE_ROLE_KEY_HERE__

# Mapbox GL token for the parcel viewer (components/parcel-map/ParcelMapViewer.tsx)
# Get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=__PASTE_YOUR_MAPBOX_ACCESS_TOKEN_HERE__

# Paystack — powers the "Unlock Full Report" payment flow
# (app/api/v1/reports/unlock-intent, app/api/v1/webhooks/paystack).
# Public key is safe client-side; secret key is server-only and is
# what verifies webhook signatures — never expose it to the client.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=__PASTE_YOUR_PAYSTACK_PUBLIC_KEY_HERE__
PAYSTACK_SECRET_KEY=__PASTE_YOUR_PAYSTACK_SECRET_KEY_HERE__

# Signs the HMAC integrity stamp on generated certificates
# (app/api/v1/reports/certificate, lib/reports/sign.ts). This is NOT a
# PKI signing key — see the comment at the top of sign.ts. Generate a
# long random value, e.g.: openssl rand -hex 32
REPORT_SIGNING_SECRET=__PASTE_A_LONG_RANDOM_SECRET_HERE__

# Base URL used to build the QR verification link on generated
# certificates (app/api/v1/reports/certificate). Set to your real
# deployed domain in production — localhost is only correct in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
